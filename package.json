{
  "name": "ungarble",
  "version": "1.0.5",
  "private": true,
  "description": "Fix garbled text from encoding errors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "package": "npm run build && npm run package:prepare",
    "package:prepare": "node scripts/package.mjs",
    "test": "npm run build && npm run test:prepare && vitest run",
    "test:prepare": "npm run package:prepare && node scripts/prepare-runtime-tests.mjs",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:runtime": "node scripts/run-runtime-tests.mjs",
    "test:package-types": "tsc --ignoreConfig --strict --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck .ci/consumer/typecheck.mts .ci/consumer/typecheck.cts",
    "test:watch": "vitest --project node",
    "typecheck": "npm run build && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "mojibake",
    "encoding",
    "utf-8",
    "garbled"
  ],
  "author": "iruizsalinas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iruizsalinas/ungarble.git"
  },
  "homepage": "https://github.com/iruizsalinas/ungarble",
  "bugs": {
    "url": "https://github.com/iruizsalinas/ungarble/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@types/node": "25.6.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/expect": "4.1.11",
    "chai": "6.3.0",
    "esbuild": "0.28.2",
    "expect-type": "1.4.0",
    "playwright": "1.64.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "sideEffects": false
}
